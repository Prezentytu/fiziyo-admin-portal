# Names only. Never put real keys, tokens or patient data here.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEV_APP_URL=
NEXT_PUBLIC_ENABLE_CLERK_PREVIEW_REDIRECTS=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_API_URL=
# Finances module runs on Stripe; set to true only where Stripe is live (fiziyo-tests N03/F01 expect it hidden)
NEXT_PUBLIC_FINANCES_ENABLED=
# Product telemetry (PostHog Cloud EU). Project key per environment: DEV project on Preview, PROD project on Production. Empty = telemetry off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_UI_HOST=
