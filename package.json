{
  "name": "fiziyo-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "skills:sync": "node scripts/sync-cursor-skills.mjs",
    "skills:check": "node scripts/sync-cursor-skills.mjs --check",
    "skills:test": "node --test scripts/sync-cursor-skills.test.mjs",
    "skills:lint": "node scripts/sync-cursor-skills.mjs --lint",
    "agent:check": "node scripts/check-agent-adapter.mjs && node scripts/check-specs-index.mjs && node scripts/check-agent-docs-graphql.mjs && node scripts/check-trunk-main.mjs && node scripts/check-agent-context.mjs && node scripts/check-agent-words.mjs && node scripts/check-funkcje.mjs",
    "docs:sync": "node scripts/sync-shared-docs.mjs",
    "principles:sync": "node scripts/sync-principles.mjs",
    "principles:check": "node scripts/sync-principles.mjs --check",
    "agent:test": "node --test scripts/*.test.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check:testids": "node scripts/check-testid-coverage.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "graphql:validate": "node scripts/validate-graphql-documents.mjs --require-schema",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{json,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "validate": "npm run lint && npm run check:testids && npm run check:design-tokens && npm run type-check && npm run test:run && npm run build",
    "prepare": "husky",
    "check:funkcje": "node scripts/check-funkcje.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@clerk/nextjs": "^6.39.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "graphql": "^17.1.0",
    "graphql-ws": "^6.4.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "posthog-js": "^1.448.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-avatar-editor": "^16.0.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@next/bundle-analyzer": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "baseline-browser-mapping": "^2.11.37",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
